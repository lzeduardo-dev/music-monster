# Copie este arquivo para .env e ajuste os valores.
# cp .env.example .env

# ── URL base da API (frontend) ───────────────────────────────────────────
# Em desenvolvimento, deixe vazio pra o Vite fazer proxy de /api →
# localhost:3002 (definido em vite.config.js).
# Em produção (Vercel), aponte pra URL absoluta do backend no Railway,
# INCLUINDO o prefixo /api. Ex:
# VITE_API_URL=https://music-monster-api.up.railway.app/api
VITE_API_URL=
