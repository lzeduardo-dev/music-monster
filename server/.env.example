# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

PORT=3002
NODE_ENV=development

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret-in-production
JWT_EXPIRY=7d

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5176

# OpenAI (tutor de IA) — gere a chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google OAuth (login com Google) — Client ID do Google Cloud
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
